{
  "name": "arlink28",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write apps/web packages docs/packages-api-plan.md",
    "format:check": "prettier --check apps/web packages docs/packages-api-plan.md",
    "lint:boundaries": "eslint -c eslint.boundaries.config.mjs --quiet apps/web packages/shared/src packages/emails/src"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "turbo": "^2.1.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.1"
  }
}
