{
	# Contact address for certificate expiry notices.
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

api.arlink28.com {
	import common
	# The API docs are for developers on a laptop, not the public internet.
	@docs path /swagger /swagger/*
	respond @docs 404
	reverse_proxy api:8080
}

# STAGED CUTOVER. While arlink28.com still points at the old server, the new site is reachable only
# here. Caddy asks for a certificate for every site below as soon as it starts, and that fails for
# a name whose DNS points elsewhere, so the main-domain sites stay commented out until the cutover.
new.arlink28.com {
	import common
	# A preview of the production site: keep it out of search results.
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy web:3000
}

