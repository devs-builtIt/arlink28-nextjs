{
	# Contact address for certificate expiry notices.
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

arlink28.com {
	import common
	reverse_proxy web:3000
}

www.arlink28.com {
	redir https://arlink28.com{uri} permanent
}

api.arlink28.com {
	import common
	# The API docs are for developers on a laptop, not the public internet.
	@docs path /swagger /swagger/*
	respond @docs 404
	reverse_proxy api:8080
}
